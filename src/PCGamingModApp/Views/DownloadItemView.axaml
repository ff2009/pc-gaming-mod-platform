<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="52"
             xmlns:vm="clr-namespace:PCGamingModApp.Core.ViewModels;assembly=PCGamingModApp.Core"
             x:DataType="vm:DownloadItemViewModel"
             x:Class="PCGamingModApp.Views.DownloadItemView">
    <Design.DataContext>
        <vm:DownloadItemViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*,70" RowDefinitions="Auto, Auto" ShowGridLines="True">
        <ProgressBar Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3"
                     Margin="0"
                     Opacity="0.25"
                     Padding="0"
                     VerticalAlignment="Stretch"
                     Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}">
            <ProgressBar.Styles>
                <Style Selector="ProgressBar">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Value" Duration="0:0:0.1"></DoubleTransition>
                        </Transitions>
                    </Setter>
                </Style>
            </ProgressBar.Styles>
        </ProgressBar>

        <StackPanel Grid.Row="0" Grid.Column="0"
                    Margin="8 0"
                    VerticalAlignment="Center">
            <Label Content="{Binding FileName, Mode=OneWay}" />
        </StackPanel>

        <!-- Downloaded Size / Total Size -->
        <StackPanel Grid.Row="0" Grid.Column="1"
                    Margin="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
            <Label Content="{Binding DownloadedSize, Mode=OneWay, StringFormat=0.00}" />
            <Label Content="/" />
            <Label Content="{Binding FileSize, Mode=OneWay, StringFormat=0.00}" />
            <Label Content="{Binding Unit, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="4 0">
            <!-- Resume Button -->
            <Button Height="24" Width="24" Background="Transparent"
                    Command="{Binding ResumeDownloadCommand}"
                    Padding="2 2 0 2"
                    IsVisible="{Binding IsResumeButtonVisible}">
                <StackPanel Orientation="Horizontal">
                    <Label Classes="icon-only-small" Content="&#xe3d0;" />
                </StackPanel>
            </Button>

            <!-- Pause Button -->
            <Button Height="24" Width="24"
                    Background="Transparent"
                    Command="{Binding PauseDownloadCommand}"
                    Padding="2 2 0 2"
                    IsVisible="{Binding IsPauseButtonVisible}">
                <StackPanel Orientation="Horizontal">
                    <Label Classes="icon-only-small" Content="&#xe39e;" />
                </StackPanel>
            </Button>

            <!-- More Options Button -->
            <Button Height="24" Width="24"
                    Background="Transparent"
                    Padding="2 2 0 2">
                <Label Classes="icon-only-small" Content="&#xe208;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Open File Location"
                                  Command="{Binding OpenFileLocationCommand}">
                            <MenuItem.Icon>
                                <Label Classes="icon-only" Content="&#xe256;" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- Cancel Button -->
            <Button Height="24" Width="24"
                    Background="Transparent"
                    Command="{Binding CancelDownloadCommand}"
                    Padding="2 2 0 2">
                <StackPanel Orientation="Horizontal">
                    <Label Classes="icon-only-small" Content="&#xe4f6;" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0"
                    Margin="8 0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Label Content="{Binding Progress, Mode=OneWay, StringFormat=0.00}" />
            <Label Content="%" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                    VerticalAlignment="Center" HorizontalAlignment="Right"
                    Margin="8 0"
                    IsVisible="{Binding InProgress}">
            <Label Content="{Binding DownloadSpeed, Mode=OneWay, StringFormat=0.00}" />
            <Label Content="{Binding Unit, Mode=OneWay}" />
            <Label Content="/s" Margin="-7 0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                    VerticalAlignment="Center" HorizontalAlignment="Right"
                    Margin="0"
                    MinWidth="80"
                    IsVisible="{Binding InProgress}">
            <Label Content="{Binding ETA, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>