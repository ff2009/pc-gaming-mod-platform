<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:vm="clr-namespace:PCGamingModApp.Core.ViewModels;assembly=PCGamingModApp.Core"
             x:DataType="vm:NewDownloadDialogViewModel"
             x:Class="PCGamingModApp.Views.NewDownloadDialogView">

    <Design.DataContext>
        <vm:NewDownloadDialogViewModel />
    </Design.DataContext>

    <!-- New Download -->
    <Grid RowDefinitions="Auto, *, *, Auto" ColumnDefinitions="*, Auto" Margin="16" ShowGridLines="False">
        <!-- URL Input -->
        <Label Grid.Column="0" Grid.ColumnSpan="2"
               Grid.Row="0"
               Content="URL"
               Margin="8,8,8,0" />
        <ScrollViewer Grid.Column="0" Grid.ColumnSpan="2"
                      Grid.Row="1"
                      Margin="8,8,8,0">
            <TextBox Text="{Binding NewDownloadUrl}"
                     AcceptsReturn="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MinHeight="60" />
        </ScrollViewer>

        <!-- File List -->
        <DataGrid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                  ItemsSource="{Binding NewDownloadList}"
                  CanUserResizeColumns="True"
                  MinHeight="200"
                  Margin="8,8,8,0"
                  AutoGenerateColumns="False"
                  BorderThickness="1" BorderBrush="Gray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" MinWidth="80" />
                <DataGridTextColumn Header="Save Path" Binding="{Binding SavePath}" MinWidth="80" />
                <DataGridTemplateColumn Header="File Size" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Label HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Label.Content>
                                    <MultiBinding StringFormat=" {0} {1}">
                                        <Binding Path="FileSize" StringFormat="0.00" />
                                        <Binding Path="Unit" />
                                    </MultiBinding>
                                </Label.Content>
                            </Label>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding $parent[DataGrid].((vm:NewDownloadDialogViewModel)DataContext).DeleteDownloadCommand}"
                                    CommandParameter="{Binding Id}"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Label Classes="icon-only" Content="&#xe4a8;" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Destination Path -->
        <Grid Grid.Column="0"
              Grid.Row="3"
              ColumnDefinitions="Auto, *"
              Margin="8,8,8,0">
            <Label Grid.Column="0" Content="Destination:"
                   VerticalAlignment="Center"
                   Margin="0,4,0,4"
                   MinWidth="80" />
            <TextBox Grid.Column="1" Text="{Binding DestinationPath}"
                     Margin="8,4,0,4"
                     MinWidth="240">
                <TextBox.InnerRightContent>
                    <Button Background="Transparent"
                            Command="{Binding SelectDownloadDestinationPathCommand}"
                            Margin="0 0 8 0"
                            Padding="0">
                        <Label Classes="icon-only" Content="&#xe248;" />
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Column="1"
                    Grid.Row="3" Orientation="Horizontal"
                    Margin="8,8,8,0"
                    HorizontalAlignment="Right"
                    MinWidth="120">
            <Button Command="{Binding StartNewDownloadCommand}"
                    IsEnabled="{Binding IsDownloadReady}"
                    HorizontalAlignment="Right"
                    Margin="0,4,8,4"
                    MinWidth="80">
                <StackPanel Orientation="Horizontal">
                    <Label Classes="icon-only" Content="&#xe20a;" />
                    <Label Content="Start" />
                </StackPanel>
            </Button>
            <Button Command="{Binding StartDownloadLaterCommand}"
                    IsEnabled="{Binding IsDownloadReady}"
                    HorizontalAlignment="Right"
                    Margin="0,4,8,4"
                    MinWidth="80">
                <StackPanel Orientation="Horizontal">
                    <Label Classes="icon-only" Content="&#xe248;" />
                    <Label Content="Later" />
                </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}"
                    Margin="0,4,0,4"
                    HorizontalAlignment="Right"
                    MinWidth="80">
                <StackPanel Orientation="Horizontal">
                    <Label Classes="icon-only" Content="&#xe4fa;" />
                    <Label Content="Cancel" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>